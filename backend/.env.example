DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/power_monitoring

# Runtime Environment (development | production | staging)
ENVIRONMENT=development

# JWT Signing Secret:
# In production, this MUST be set to a cryptographically secure random string (minimum 32 characters).
# DO NOT copy a placeholder value. Generate a fresh secret using one of:
#   Linux / macOS / Git Bash : openssl rand -hex 32
#   Python (cross-platform)  : python -c "import secrets; print(secrets.token_hex(32))"
#   Windows PowerShell       : powershell -Command "[Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))"
# In development, an ephemeral session secret is generated automatically if omitted or left blank.
JWT_SECRET=<GENERATE_SECURE_RANDOM_SECRET_MIN_32_CHARS>

# Initial Administrator Provisioning:
# Used ONLY on initial database creation if no administrator account exists.
# Once provisioned, credentials are not reset by startup or environment changes.
# Passwords must be at least 8 characters and not use common defaults (admin, password, 123456).
ADMIN_USERNAME=sysadmin
ADMIN_PASSWORD=replace-with-strong-initial-password-min8chars

# Device Ingestion Key:
# Shared secret for hardware telemetry ingestion via 'X-Ingest-Key' HTTP header.
INGEST_API_KEY=replace-with-device-ingest-api-key

# Telemetry Timing and Staleness Tolerances:
DEVICE_OFFLINE_SECONDS=120
CLOCK_SKEW_TOLERANCE_SECONDS=60

# Site monitoring bands (confirm before operational use).
# Leave OVERCURRENT_AMPS and HIGH_TEMPERATURE_C empty until the installation values are known.
NOMINAL_PHASE_VOLTAGE=230
UNDERVOLTAGE_RATIO=0.85
OVERVOLTAGE_RATIO=1.10
VOLTAGE_ABSENT_MAX=15
# OVERCURRENT_AMPS=32
# HIGH_TEMPERATURE_C=60
IMBALANCE_PERCENT=10
# SUDDEN_VOLTAGE_DELTA=40
# SUDDEN_CURRENT_DELTA=10
FREQUENCY_NOMINAL=50
# FREQUENCY_TOLERANCE_HZ=2.5

